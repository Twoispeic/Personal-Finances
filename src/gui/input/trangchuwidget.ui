  <property name="styleSheet">
   <string notr="true">
    /* MÀU NỀN TỔNG THỂ */
    QWidget#TrangChuWidget {
        background-color: #12142B;
        color: #F4F5FC;
        font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, sans-serif;
    }

    /* STYLE CHO CÁC KHUNG CARD */
    QFrame#cardThuNhap, QFrame#cardChiTieu, QFrame#cardSoDu, QFrame#cardChart, QFrame#cardGoals {
        background-color: #1B1E42;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.07);
    }

    /* MẶC ĐỊNH LABEL KHÔNG CÓ NỀN TRẮNG */
    QLabel {
        background-color: transparent;
        border: none;
    }

    /* CHỮ TIÊU ĐỀ */
    QLabel#lblHeader { font-size: 26px; font-weight: bold; color: #ffffff; }
    QLabel#lblSubHeader { font-size: 14px; color: #8A8FC0; }

    /* AVATAR TRÒN CÓ GRADIENT */
    QLabel#lblAvatar {
        background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #F2508C, stop:1 #6E7BFA);
        border-radius: 22px;
        font-weight: bold;
        font-size: 16px;
    }

    /* CHỮ NHỎ TRONG CARD */
    QLabel#statTitle1, QLabel#statTitle2, QLabel#statTitle3 { color: #8A8FC0; font-size: 12px; font-weight: bold; }
    QLabel#statSub1, QLabel#statSub2, QLabel#statSub3 { color: #5F638F; font-size: 12px; }
    QLabel#lblChartTitle, QLabel#lblGoalsTitle { font-size: 16px; font-weight: bold; }

    /* NHỮNG CON SỐ BIẾT NÓI */
    QLabel#lblThuNhap { color: #35DDC0; font-size: 26px; font-weight: bold; font-family: &quot;JetBrains Mono&quot;;}
    QLabel#lblChiTieu { color: #F2508C; font-size: 26px; font-weight: bold; font-family: &quot;JetBrains Mono&quot;;}
    QLabel#lblSoDu { color: #ffffff; font-size: 26px; font-weight: bold; font-family: &quot;JetBrains Mono&quot;;}

    /* STYLE CHO NÚT BẤM (MỤC TIÊU) */
    QPushButton {
        background-color: #212553;
        border-radius: 14px;
        padding: 14px;
        color: #F4F5FC;
        text-align: left;
        font-weight: bold;
    }
    QPushButton:hover { background-color: #2A2F66; }
   </string>
